# ==============================================================================
# TutorConnect - Environment Configuration Template
# Engineered by Divyansh Mishra
# ==============================================================================
# Copy this file to '.env' in the project root before running docker-compose or local services.
# NEVER commit real production secrets, database credentials, or private keys.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Django Core Configuration
# ------------------------------------------------------------------------------
DEBUG=False
SECRET_KEY=django-insecure-tutorconnect-saas-replace-this-in-production-divyansh-2026
ALLOWED_HOSTS=localhost,127.0.0.1,backend,frontend,0.0.0.0

# ------------------------------------------------------------------------------
# 2. Database Connection (PostgreSQL 16)
# ------------------------------------------------------------------------------
DATABASE_URL=postgres://tutorconnect_user:tutorconnect_secure_password_2026@postgres:5432/tutorconnect_db

# ------------------------------------------------------------------------------
# 3. Redis Cache & Celery Task Broker
# ------------------------------------------------------------------------------
# Redis DB Index 1: Application query and session caching
REDIS_URL=redis://redis:6379/1

# Redis DB Index 0: Celery asynchronous message broker
CELERY_BROKER_URL=redis://redis:6379/0

# ------------------------------------------------------------------------------
# 4. Stripe Payments (Test Mode Simulation)
# ------------------------------------------------------------------------------
STRIPE_PUBLIC_KEY=pk_test_sample_tutorconnect_key
STRIPE_SECRET_KEY=sk_test_sample_tutorconnect_key
STRIPE_WEBHOOK_SECRET=whsec_sample_tutorconnect_secret

# ------------------------------------------------------------------------------
# 5. Frontend & CORS Network Configuration
# ------------------------------------------------------------------------------
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost

# Frontend Client Environment (Vite)
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_STRIPE_PUBLIC_KEY=pk_test_sample_tutorconnect_key

# ------------------------------------------------------------------------------
# 6. Email Delivery Configuration
# ------------------------------------------------------------------------------
# In development: outputs emails directly to terminal stdout
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
