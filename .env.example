# ==========================================
# TutorConnect Environment Variables
# ==========================================

# Django Configuration
DEBUG=False
SECRET_KEY=django-insecure-tutorconnect-saas-replace-this-in-production-divyansh-2026
ALLOWED_HOSTS=localhost,127.0.0.1,backend,frontend,0.0.0.0

# Database (PostgreSQL)
DATABASE_URL=postgres://tutorconnect_user:tutorconnect_secure_password_2026@postgres:5432/tutorconnect_db

# Redis Caching & Celery Broker
REDIS_URL=redis://redis:6379/1
CELERY_BROKER_URL=redis://redis:6379/0

# Stripe Payments (Test Mode)
STRIPE_PUBLIC_KEY=pk_test_sample_tutorconnect_key
STRIPE_SECRET_KEY=sk_test_sample_tutorconnect_key
STRIPE_WEBHOOK_SECRET=whsec_sample_tutorconnect_secret

# Frontend App URL & CORS
